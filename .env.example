# Exemplo de ambiente do astralai. SÓ NOMES: os valores ficam no Infisical (rt-produtos/astralai, ambiente prod) e chegam à VPS no deploy. Nunca commitar valores.
# Em desenvolvimento local basta copiar para .env e preencher o que for usar; sem SMTP/LLM o app roda em modo de desenvolvimento.

ASTRALAI_ADMIN_KEY=
ASTRALAI_CAKTO_SEGREDO=
ASTRALAI_DEMO_SENHA=
ASTRALAI_LLM_KEY=
ASTRALAI_SEGREDO_SESSAO=
ASTRALAI_SMTP_FROM=
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=
SMTP_USER=
